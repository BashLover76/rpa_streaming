FROM docker:29-cli AS docker-cli

FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMING_DB_PATH=/data/streaming.db \
    FLASK_ENV=production

WORKDIR /app

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements-web.txt

RUN mkdir -p /data .continue logs tools

COPY config ./config
COPY browser_extension ./browser_extension
COPY ingestion ./ingestion
COPY tools ./tools
COPY static ./static
COPY templates ./templates
COPY web_app.py .
COPY main_ingestion.py .
COPY Dockerfile.rpa .
COPY docker-compose.rpa.yml .

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:5000/api/mobile/bootstrap >/dev/null || exit 1

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--threads", "4", "--timeout", "60", "web_app:create_app()"]
