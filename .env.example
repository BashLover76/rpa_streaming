# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
STREAMING_DB_PATH=streaming.db
RPA_USER_DATA_DIR=.playwright-profile
ADMIN_TOKEN=generate_a_long_random_value
PLATFORM_CONFIG_PATH=config/platforms.example.json
RPA_BROWSER_EXTENSION_PATH=browser_extension/streaming-rpa-helper

# -----------------------------------------------------------------------------
# Service configs
# -----------------------------------------------------------------------------
BETASERIES_CONFIG_FILE=config/betaseries.example.json
OLLAMA_CONFIG_FILE=config/ollama.example.json
CRUNCHYROLL_CONFIG_FILE=config/crunchyroll.example.json
STREAMING_PROFILES_FILE=config/streaming_profiles.example.json

# -----------------------------------------------------------------------------
# Streaming platform activation and RPA login config
# -----------------------------------------------------------------------------
STREAMING_PLATFORMS_FILE=config/streaming_platforms.example.json
STREAMING_PLATFORM_CONFIG_FILE=config/streaming_platform_config.example.json

# -----------------------------------------------------------------------------
# Chrome / CDP
# -----------------------------------------------------------------------------
# Chrome Windows launched with --remote-debugging-port=9222.
# Leave empty to let Playwright launch its own persistent Chromium.
RPA_CDP_URL=http://127.0.0.1:9222
RPA_STORAGE_STATE_PATH=.continue/browser-storage-state.json

# -----------------------------------------------------------------------------
# Docker images
# -----------------------------------------------------------------------------
STREAMING_WEB_IMAGE=rpa-streaming-web
STREAMING_WEB_TAG=1.0.0
STREAMING_RPA_IMAGE=rpa-streaming-rpa
STREAMING_RPA_TAG=1.0.0
STREAMING_CHROME_IMAGE=zenika/alpine-chrome
STREAMING_CHROME_TAG=latest
