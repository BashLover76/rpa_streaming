BETASERIES_API_KEY=your_betaseries_api_key
BETASERIES_CLIENT_SECRET=your_oauth2_key_or_secret_key
BETASERIES_ACCESS_TOKEN=
BETASERIES_USER_ID=
# Recommended vision model for DOM/screenshot extraction
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=4096
OLLAMA_TIMEOUT=300
STREAMING_DB_PATH=streaming.db
RPA_USER_DATA_DIR=.playwright-profile
# Profile matrix format:
# key|display label|technical id|is junior ; key2|display label 2|technical id 2|false
STREAMING_PROFILES=default|Profil principal|default|false;junior|Profil junior|junior|true
DEFAULT_PROFILE_KEY=default
DEFAULT_PROFILE_LABEL=Profil principal
DEFAULT_PROFILE_TECHNICAL_ID=default
DEFAULT_PROFILE_IS_JUNIOR=false
# Chrome Windows launched with --remote-debugging-port=9222
# Leave empty to let Playwright launch its own persistent Chromium.
RPA_CDP_URL=http://127.0.0.1:9222
ADMIN_TOKEN=generate_a_long_random_value
PLATFORM_CONFIG_PATH=config/platforms.example.json
RPA_BROWSER_EXTENSION_PATH=browser_extension/streaming-rpa-helper

# Crunchyroll unofficial API adapter.
CRUNCHYROLL_EMAIL=
CRUNCHYROLL_PASSWORD=
CRUNCHYROLL_AUTHORIZATION=
CRUNCHYROLL_PROFILE_ID=
CRUNCHYROLL_LOCALE=fr-FR

# Streaming platform activation and RPA login config.
# Keep real values only in .env, never in git.
STREAMING_PLATFORMS_FILE=config/streaming_platforms.local.json
STREAMING_PLATFORM_CONFIG_FILE=config/streaming_platform_config.local.json
STREAMING_WEB_IMAGE=rpa-streaming-web
STREAMING_WEB_TAG=0.3.0
STREAMING_RPA_IMAGE=rpa-streaming-rpa
STREAMING_RPA_TAG=0.3.0
