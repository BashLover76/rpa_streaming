{
  "name": "canal_plus",
  "display_name": "CANAL+",
  "country": "FR",
  "strategy": "rpa",
  "api": {
    "available": false,
    "notes": "Les endpoints CANAL+/myCANAL sont privés et changent régulièrement. Le RPA persistant est privilégié."
  },
  "rpa": {
    "start_url": "https://www.canalplus.com/",
    "login_url": "https://www.canalplus.com/connexion",
    "wait_after_login_seconds": 18,
    "requires_browser_extension": true,
    "strict_history_scope": true,
    "profile_name": "chris",
    "selectors": {
      "profile": "button:has(img), a:has(img), [role='button']:has(img), button:not(:has-text('Ajouter')):not(:has-text('Gérer')):not(:has-text('Modifier')), a:not(:has-text('Ajouter')):not(:has-text('Gérer')):not(:has-text('Modifier'))",
      "my_videos": "a:has-text('Mes vidéos'), a:has-text('Mes videos'), a[href*='mes-videos'], a[href*='my-videos']",
      "recently_watched": "a:has-text('Vu récemment'), a:has-text('Vus récemment'), button:has-text('Vu récemment'), button:has-text('Vus récemment'), a[href*='vu-recemment'], a[href*='recent']",
      "history_container": "main, [role='main'], body",
      "history_rows": "a[title][href*='/'], article a[title][href], li a[title][href], [data-testid*='card'] a[title][href]",
      "cookie_accept": "button:has-text('Accepter'), button:has-text('Continuer sans accepter')",
      "logged_in_indicator": "a:has-text('Mes vidéos'), a:has-text('Mes videos'), a[href*='mes-videos']",
      "login_email": "input[type='email'], input[name='email'], input[name='login']",
      "login_password": "input[type='password'], input[name='password']",
      "login_submit": "button[type='submit'], button:has-text('Continuer'), button:has-text('Se connecter'), button:has-text('Connexion')",
      "show_more": "button:has-text('Voir plus'), button:has-text('Plus')"
    }
  }
}
